diff --git a/airoha-xpon/src/airoha-xpon-epon.c b/airoha-xpon/src/airoha-xpon-epon.c
--- a/airoha-xpon/src/airoha-xpon-epon.c
+++ b/airoha-xpon/src/airoha-xpon-epon.c
@@ -524,7 +524,10 @@ static int airoha_xpon_epon_start_mac(struct airoha_xpon *xpon)
 	airoha_pon_phy_update_bits(xpon, AIROHA_XEPON_PHY_CSR_DUMMY_RX,
 	                           AIROHA_XEPON_PHY_CONTINUOUS_TX, 0);
 
-	/* 10G EPON reports across 16 queue bits with report configuration 1. */
+	/*
+	 * Program the MAC REPORT queue-bitmap register. Its register value is
+	 * distinct from the 8-bit queue bitmap encoded in an IEEE MPCP REPORT PDU.
+	 */
 	airoha_epon_write(xpon, AIROHA_EPON_REPORT_BITMAP, 0xffff);
 	airoha_epon_write(xpon, AIROHA_EPON_REPORT_CFG, 1);
