From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: respect hash request sleepability

The hash submit path waits for ring space with usleep_range(). That wait is
valid only when the caller permits sleeping. For non-sleepable requests, do
not publish a partial request and then fail: reject requests requiring more
than one hardware batch before the first descriptor is visible, and return
-EBUSY if the single batch cannot be reserved atomically.

The internal HMAC setkey helper waits synchronously for its ahash operations,
so mark those requests as sleepable.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-hash.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-hash.c
@@ -419,6 +419,11 @@
 	unsigned int block_idx = 0, submitted = 0;
 	bool committed = false;
 
+	if (!(req->base.flags & CRYPTO_TFM_REQ_MAY_SLEEP) &&
+	    (total > FIELD_MAX(EIP93_PE_CD_COUNT_INCR) ||
+	    total > EIP93_RING_NUM - 1))
+		return -EBUSY;
+
 	while (submitted < total) {
 		unsigned int count = min_t(unsigned int, total - submitted,
 					     FIELD_MAX(EIP93_PE_CD_COUNT_INCR));
@@ -491,6 +496,11 @@
 			if (ret != -ENOSPC)
 				break;
 
+			if (!(req->base.flags & CRYPTO_TFM_REQ_MAY_SLEEP)) {
+				ret = -EBUSY;
+				break;
+			}
+
 			usleep_range(EIP93_RING_BUSY_DELAY,
 				     EIP93_RING_BUSY_DELAY * 2);
 		}
--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -859,7 +859,8 @@
 
 	rctx = ahash_request_ctx_dma(req);
 	crypto_init_wait(&wait);
-	ahash_request_set_callback(req, CRYPTO_TFM_REQ_MAY_BACKLOG,
+	ahash_request_set_callback(req, CRYPTO_TFM_REQ_MAY_SLEEP |
+				   CRYPTO_TFM_REQ_MAY_BACKLOG,
 				   crypto_req_done, &wait);
 
 	/* Hash the key if > SHA256_BLOCK_SIZE */
