From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: validate imported hash staging state

The exported state stores the unprocessed tail in a fixed 64-byte buffer.
Validate both its declared length and the driver's tail-length invariant
before copying any imported fields into the request context. This prevents
an oversized data_used value from overrunning the request context and rejects
states that would later produce an invalid zero-length final DMA mapping.

HMAC import must also reject use before a successful setkey, matching init.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-hash.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-hash.c
@@ -771,8 +771,24 @@
 static int eip93_hash_import(struct ahash_request *req, const void *in)
 {
 	struct eip93_hash_reqctx *rctx = ahash_request_ctx_dma(req);
+	struct crypto_ahash *ahash = crypto_ahash_reqtfm(req);
+	struct eip93_hash_ctx *ctx = crypto_ahash_ctx(ahash);
 	const struct eip93_hash_export_state *state = in;
 	struct sa_state *sa_state = &rctx->sa_state;
+	unsigned int expected_data_used;
+
+	if (IS_HMAC(ctx->flags) && !ctx->key_set)
+		return -EINVAL;
+	if (IS_HMAC(ctx->flags) && state->len < SHA256_BLOCK_SIZE)
+		return -EINVAL;
+
+	if (state->data_used > SHA256_BLOCK_SIZE)
+		return -EINVAL;
+
+	expected_data_used = state->len ?
+		((state->len - 1) % SHA256_BLOCK_SIZE) + 1 : 0;
+	if (state->data_used != expected_data_used)
+		return -EINVAL;
 
 	memcpy(sa_state->state_byte_cnt, state->state_len, sizeof(u32) * 2);
	memcpy(sa_state->state_i_digest, state->state_hash, SHA256_DIGEST_SIZE);
