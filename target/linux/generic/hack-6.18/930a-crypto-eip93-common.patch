+int eip93_put_descriptors(struct eip93_device *eip93,
+			  struct eip93_descriptor *descs,
+			  unsigned int count, unsigned int *available)
+{
+	struct eip93_desc_ring cdr, rdr;
+	struct eip93_descriptor *cdesc, *rdesc;
+	unsigned int i;
+
+	*available = 0;
+	if (!count || count > FIELD_MAX(EIP93_PE_CD_COUNT_INCR))
+		return -EINVAL;
+
+	/*
+	 * The caller holds ring_lock.  First walk private ring copies so an
+	 * insufficient paired ring never advances either live write pointer.
+	 */
+	cdr = eip93->ring->cdr;
+	rdr = eip93->ring->rdr;
+	for (i = 0; i < count; i++) {
+		rdesc = eip93_ring_peek_wptr(&rdr);
+		cdesc = eip93_ring_peek_wptr(&cdr);
+		if (IS_ERR(rdesc) || IS_ERR(cdesc)) {
+			*available = i;
+			return -ENOSPC;
+		}
+		eip93_ring_advance_wptr(&rdr);
+		eip93_ring_advance_wptr(&cdr);
+	}
+
+	/* Capacity is proven.  Fill the complete batch before publishing it. */
+	cdr = eip93->ring->cdr;
+	rdr = eip93->ring->rdr;
+	for (i = 0; i < count; i++) {
+		rdesc = eip93_ring_peek_wptr(&rdr);
+		cdesc = eip93_ring_peek_wptr(&cdr);
+		memset(rdesc, 0, sizeof(*rdesc));
+		memcpy(cdesc, &descs[i], sizeof(*cdesc));
+		eip93_ring_advance_wptr(&rdr);
+		eip93_ring_advance_wptr(&cdr);
+	}
+
+	eip93->ring->rdr.write = rdr.write;
+	eip93->ring->cdr.write = cdr.write;
+	dma_wmb();
+	*available = count;
 
 	return 0;
 }
