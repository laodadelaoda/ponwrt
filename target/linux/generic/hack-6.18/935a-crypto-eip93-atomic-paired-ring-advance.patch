From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: advance paired descriptor rings atomically

Inspect both command/result ring slots before advancing either pointer.
Apply the same paired check to result consumption, so a missing partner
descriptor cannot leave the two software ring indices out of step.

A single ring_lock serializes both producers and consumers. This also makes
paired pointer inspection safe against concurrent updates to the partner ring.

--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -68,17 +68,22 @@
-static void *eip93_ring_next_wptr(struct eip93_device *eip93,
-				  struct eip93_desc_ring *ring)
+static void *eip93_ring_peek_wptr(struct eip93_desc_ring *ring)
 {
 	void *ptr = ring->write;
 
-	if ((ring->write == ring->read - ring->offset) ||
-	    (ring->read == ring->base && ring->write == ring->base_end))
-		return ERR_PTR(-ENOMEM);
+	if (ring->write == ring->base_end) {
+		if (ring->read == ring->base)
+			return ERR_PTR(-ENOMEM);
+	} else if ((u8 *)ring->write + ring->offset == (u8 *)ring->read) {
+		return ERR_PTR(-ENOMEM);
+	}
 
+	return ptr;
+}
+
+static void eip93_ring_advance_wptr(struct eip93_desc_ring *ring)
+{
 	if (ring->write == ring->base_end)
 		ring->write = ring->base;
 	else
 		ring->write += ring->offset;
-
-	return ptr;
 }
 
@@ -85,16 +90,18 @@
-static void *eip93_ring_next_rptr(struct eip93_device *eip93,
-				  struct eip93_desc_ring *ring)
+static void *eip93_ring_peek_rptr(struct eip93_desc_ring *ring)
 {
 	void *ptr = ring->read;
 
 	if (ring->write == ring->read)
 		return ERR_PTR(-ENOENT);
 
+	return ptr;
+}
+
+static void eip93_ring_advance_rptr(struct eip93_desc_ring *ring)
+{
 	if (ring->read == ring->base_end)
 		ring->read = ring->base;
 	else
 		ring->read += ring->offset;
-
-	return ptr;
 }
 
@@ -107,11 +114,15 @@
-	rdesc = eip93_ring_next_wptr(eip93, &eip93->ring->rdr);
+	rdesc = eip93_ring_peek_wptr(&eip93->ring->rdr);
 	if (IS_ERR(rdesc))
 		return -ENOENT;
 
-	cdesc = eip93_ring_next_wptr(eip93, &eip93->ring->cdr);
+	cdesc = eip93_ring_peek_wptr(&eip93->ring->cdr);
 	if (IS_ERR(cdesc))
 		return -ENOENT;
 
+	eip93_ring_advance_wptr(&eip93->ring->rdr);
+	eip93_ring_advance_wptr(&eip93->ring->cdr);
+
 	memset(rdesc, 0, sizeof(struct eip93_descriptor));
 
 	memcpy(cdesc, desc, sizeof(struct eip93_descriptor));
+	dma_wmb();
@@ -127,12 +138,14 @@
-	cdesc = eip93_ring_next_rptr(eip93, &eip93->ring->cdr);
+	cdesc = eip93_ring_peek_rptr(&eip93->ring->cdr);
 	if (IS_ERR(cdesc))
 		return ERR_PTR(-ENOENT);
 
-	memset(cdesc, 0, sizeof(struct eip93_descriptor));
-
-	ptr = eip93_ring_next_rptr(eip93, &eip93->ring->rdr);
+	ptr = eip93_ring_peek_rptr(&eip93->ring->rdr);
 	if (IS_ERR(ptr))
 		return ERR_PTR(-ENOENT);
 
+	eip93_ring_advance_rptr(&eip93->ring->cdr);
+	eip93_ring_advance_rptr(&eip93->ring->rdr);
+	memset(cdesc, 0, sizeof(struct eip93_descriptor));
+
 	return ptr;
 }
--- a/drivers/crypto/inside-secure/eip93/eip93-main.h
+++ b/drivers/crypto/inside-secure/eip93/eip93-main.h
@@ -127,2 +127,1 @@
-	spinlock_t			write_lock;
-	spinlock_t			read_lock;
+	spinlock_t			ring_lock;
--- a/drivers/crypto/inside-secure/eip93/eip93-main.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-main.c
@@ -210,1 +210,1 @@
-		scoped_guard(spinlock_irqsave, &eip93->ring->read_lock)
+		scoped_guard(spinlock_irqsave, &eip93->ring->ring_lock)
@@ -453,2 +453,1 @@
-	spin_lock_init(&eip93->ring->read_lock);
-	spin_lock_init(&eip93->ring->write_lock);
+	spin_lock_init(&eip93->ring->ring_lock);
--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -525,1 +538,1 @@
-		scoped_guard(spinlock_irqsave, &eip93->ring->write_lock)
+		scoped_guard(spinlock_irqsave, &eip93->ring->ring_lock)
--- a/drivers/crypto/inside-secure/eip93/eip93-hash.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-hash.c
@@ -302,1 +302,1 @@
-	scoped_guard(spinlock_irqsave, &eip93->ring->write_lock)
+	scoped_guard(spinlock_irqsave, &eip93->ring->ring_lock)
