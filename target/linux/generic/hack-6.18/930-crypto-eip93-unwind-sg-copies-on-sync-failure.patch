From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: unwind request SG copies on sync failure

The request path may allocate private scatterlist/page copies before DMA
submission. If validation or a later synchronous allocation/mapping step
fails, no completion callback runs to release those copies.

Release only driver-owned copies on every synchronous exit, preserve the
caller's scatterlists, and do not complete an asynchronous request callback
for an error returned synchronously.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -147,6 +147,21 @@ static void eip93_free_sg_copy(const int len, struct scatterlist **sg)
 	*sg = NULL;
 }
 
+void eip93_cleanup_sg_copies(struct eip93_cipher_reqctx *rctx,
+			     struct scatterlist *reqsrc,
+			     struct scatterlist *reqdst)
+{
+	u32 len = rctx->assoclen + rctx->textsize + rctx->authsize;
+
+	if (rctx->sg_src != reqsrc)
+		eip93_free_sg_copy(len, &rctx->sg_src);
+	if (rctx->sg_dst != reqdst)
+		eip93_free_sg_copy(len, &rctx->sg_dst);
+
+	rctx->sg_src = reqsrc;
+	rctx->sg_dst = reqdst;
+}
+
 static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
 			      const u32 len, const bool copy)
 {
--- a/drivers/crypto/inside-secure/eip93/eip93-cipher.h
+++ b/drivers/crypto/inside-secure/eip93/eip93-cipher.h
@@ -49,4 +49,8 @@ int check_valid_request(struct eip93_cipher_reqctx *rctx);
 
+void eip93_cleanup_sg_copies(struct eip93_cipher_reqctx *rctx,
+			     struct scatterlist *reqsrc,
+			     struct scatterlist *reqdst);
+
 void eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx,
 		     struct scatterlist *reqsrc, struct scatterlist *reqdst);
 
--- a/drivers/crypto/inside-secure/eip93/eip93-cipher.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-cipher.c
@@ -43,9 +43,14 @@ static int eip93_skcipher_send_req(struct crypto_async_request *async)
 	err = check_valid_request(rctx);
 
-	if (err)
+	if (err) {
+		eip93_cleanup_sg_copies(rctx, req->src, req->dst);
 		return err;
+	}
 
-	return eip93_send_req(async, req->iv, rctx);
+	err = eip93_send_req(async, req->iv, rctx);
+	if (err != -EINPROGRESS)
+		eip93_cleanup_sg_copies(rctx, req->src, req->dst);
+	return err;
 }
 
 /* Crypto skcipher API functions */
--- a/drivers/crypto/inside-secure/eip93/eip93-aead.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-aead.c
@@ -48,11 +48,14 @@ static int eip93_aead_send_req(struct crypto_async_request *async)
 
 	err = check_valid_request(rctx);
 	if (err) {
-		aead_request_complete(req, err);
+		eip93_cleanup_sg_copies(rctx, req->src, req->dst);
 		return err;
 	}
 
-	return eip93_send_req(async, req->iv, rctx);
+	err = eip93_send_req(async, req->iv, rctx);
+	if (err != -EINPROGRESS)
+		eip93_cleanup_sg_copies(rctx, req->src, req->dst);
+	return err;
 }
 
 /* Crypto aead API functions */
