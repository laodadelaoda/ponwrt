 	kfree(ctx->sa_record);
 }
 
@@ -152,8 +158,6 @@ static int eip93_aead_setkey(struct crypto_aead *ctfm, const u8 *key,
 				ctx->authsize, sa_record->sa_i_digest,
 				sa_record->sa_o_digest, false);
 
