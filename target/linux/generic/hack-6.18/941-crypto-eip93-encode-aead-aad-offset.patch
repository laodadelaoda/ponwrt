From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: encode AEAD AAD offset in supported units

The SA HASH_CRYPT_OFFSET field is eight bits wide. By default it counts
32-bit words; EIP93 also provides BYTE_OFFSET to count bytes. The request
path previously divided assoclen by four unconditionally and silently
truncated offsets that did not fit the field.

Use word units for four-byte-aligned AAD and byte units for unaligned AAD
when representable. Reject offsets that cannot be encoded rather than
submitting a descriptor with a truncated AAD boundary.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-aead.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-aead.c
@@ -197,9 +197,21 @@
 						 EIP93_SA_CMD_COPY_DIGEST;
 	}
 
-	rctx->sa_record.sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
-	rctx->sa_record.sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
-						    req->assoclen / sizeof(u32));
+	rctx->sa_record.sa_cmd1_word &= ~(EIP93_SA_CMD_HASH_CRYPT_OFFSET |
+					   EIP93_SA_CMD_BYTE_OFFSET);
+	if (IS_ALIGNED(req->assoclen, sizeof(u32))) {
+		if (req->assoclen / sizeof(u32) >
+		    FIELD_MAX(EIP93_SA_CMD_HASH_CRYPT_OFFSET))
+			return -EINVAL;
+		rctx->sa_record.sa_cmd1_word |=
+			FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+				   req->assoclen / sizeof(u32));
+	} else {
+		if (req->assoclen > FIELD_MAX(EIP93_SA_CMD_HASH_CRYPT_OFFSET))
+			return -EINVAL;
+		rctx->sa_record.sa_cmd1_word |= EIP93_SA_CMD_BYTE_OFFSET |
+			FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET, req->assoclen);
+	}
 
 	rctx->sa_record_base = dma_map_single(ctx->eip93->dev, &rctx->sa_record,
 					     sizeof(rctx->sa_record), DMA_TO_DEVICE);
