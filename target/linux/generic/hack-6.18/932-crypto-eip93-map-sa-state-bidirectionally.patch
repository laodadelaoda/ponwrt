From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: map mutable SA state bidirectionally

The packet engine reads and updates SA state. Use DMA_BIDIRECTIONAL for
mapping and unmapping these buffers consistently. Key and SA record buffers
remain DMA_TO_DEVICE.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-hash.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-hash.c
@@ -70,1 +70,1 @@
-			 sizeof(*sa_state), DMA_FROM_DEVICE);
+			 sizeof(*sa_state), DMA_BIDIRECTIONAL);
@@ -404,1 +404,1 @@
-					     DMA_TO_DEVICE);
+					     DMA_BIDIRECTIONAL);
@@ -428,1 +428,1 @@
-			 sizeof(*sa_state), DMA_TO_DEVICE);
+			 sizeof(*sa_state), DMA_BIDIRECTIONAL);
@@ -480,1 +480,1 @@
-						     DMA_TO_DEVICE);
+						     DMA_BIDIRECTIONAL);
@@ -509,1 +509,1 @@
-			 sizeof(*sa_state), DMA_TO_DEVICE);
+			 sizeof(*sa_state), DMA_BIDIRECTIONAL);
@@ -532,1 +532,1 @@
-						     DMA_TO_DEVICE);
+						     DMA_BIDIRECTIONAL);
@@ -556,1 +556,1 @@
-			 sizeof(*sa_state), DMA_TO_DEVICE);
+			 sizeof(*sa_state), DMA_BIDIRECTIONAL);
