From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: validate request IDs and result ownership

Use the complete 16-bit descriptor ID space, reject hash request ID allocation
failures with full DMA unwind, and guard result dispatch against missing
requests. Order descriptor reads after observing PE_READY.

------ a/drivers/crypto/inside-secure/eip93/eip93-main.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-main.c
@@ -222,6 +222,8 @@ DMA read barrier
-		} while (FIELD_GET(EIP93_PE_CTRL_PE_READY_DES_TRING_OWN, pe_ctrl_stat) !=
-			 EIP93_PE_CTRL_PE_READY ||
-			 FIELD_GET(EIP93_PE_LENGTH_HOST_PE_READY, pe_length) !=
-			 EIP93_PE_LENGTH_PE_READY);
-
-		err = rdesc->pe_ctrl_stat_word & (EIP93_PE_CTRL_PE_EXT_ERR_CODE |
+		} while (FIELD_GET(EIP93_PE_CTRL_PE_READY_DES_TRING_OWN, pe_ctrl_stat) !=
+			 EIP93_PE_CTRL_PE_READY ||
+			 FIELD_GET(EIP93_PE_LENGTH_HOST_PE_READY, pe_length) !=
+			 EIP93_PE_LENGTH_PE_READY);
+
+		dma_rmb();
+
+		err = rdesc->pe_ctrl_stat_word & (EIP93_PE_CTRL_PE_EXT_ERR_CODE |
@@ -253,5 +255,12 @@ missing IDR result guard
-		async = idr_find(&eip93->ring->crypto_async_idr, crypto_idr);
-		idr_remove(&eip93->ring->crypto_async_idr, crypto_idr);
-	}
-
-	/* Parse error in ctrl stat word */
+		async = idr_find(&eip93->ring->crypto_async_idr, crypto_idr);
+		idr_remove(&eip93->ring->crypto_async_idr, crypto_idr);
+	}
+
+	if (unlikely(!async)) {
+		dev_warn_ratelimited(eip93->dev,
+				     "missing async request for result ID %u\n",
+				     crypto_idr);
+		goto get_more;
+	}
+
+	/* Parse error in ctrl stat word */
