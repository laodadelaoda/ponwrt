From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: stage EIP93 hash requests before descriptor submission

Build hash input blocks without mutating request state, reject short SG reads,
map every block and final buffer, map SA resources, and reserve the completion
ID before committing descriptors. For finup, prepare intermediate and final
descriptors as one transaction. Submit prepared descriptors under the unified
ring lock after checking paired-ring capacity; no fallible DMA or IDR work
remains after the first descriptor is visible.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -149,1 +149,50 @@
-void *eip93_get_descriptor(struct eip93_device *eip93)
+int eip93_put_descriptors(struct eip93_device *eip93,
+			  struct eip93_descriptor *descs,
+			  unsigned int count, unsigned int *available)
+{
+	struct eip93_desc_ring cdr, rdr;
+	struct eip93_descriptor *cdesc, *rdesc;
+	unsigned int i;
+
+	*available = 0;
+	if (!count || count > FIELD_MAX(EIP93_PE_CD_COUNT_INCR))
+		return -EINVAL;
+
+	/*
+	 * The caller holds ring_lock.  First walk private ring copies so an
+	 * insufficient paired ring never advances either live write pointer.
+	 */
+	cdr = eip93->ring->cdr;
+	rdr = eip93->ring->rdr;
+	for (i = 0; i < count; i++) {
+		rdesc = eip93_ring_peek_wptr(&rdr);
+		cdesc = eip93_ring_peek_wptr(&cdr);
+		if (IS_ERR(rdesc) || IS_ERR(cdesc)) {
+			*available = i;
+			return -ENOSPC;
+		}
+		eip93_ring_advance_wptr(&rdr);
+		eip93_ring_advance_wptr(&cdr);
+	}
+
+	/* Capacity is proven.  Fill the complete batch before publishing it. */
+	cdr = eip93->ring->cdr;
+	rdr = eip93->ring->rdr;
+	for (i = 0; i < count; i++) {
+		rdesc = eip93_ring_peek_wptr(&rdr);
+		cdesc = eip93_ring_peek_wptr(&cdr);
+		memset(rdesc, 0, sizeof(*rdesc));
+		memcpy(cdesc, &descs[i], sizeof(*cdesc));
+		eip93_ring_advance_wptr(&rdr);
+		eip93_ring_advance_wptr(&cdr);
+	}
+
+	eip93->ring->rdr.write = rdr.write;
+	eip93->ring->cdr.write = cdr.write;
+	dma_wmb();
+	*available = count;
+
+	return 0;
+}
+
+void *eip93_get_descriptor(struct eip93_device *eip93)
--- a/drivers/crypto/inside-secure/eip93/eip93-common.h
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.h
@@ -13,2 +13,5 @@
 void *eip93_get_descriptor(struct eip93_device *eip93);
+int eip93_put_descriptors(struct eip93_device *eip93,
+			  struct eip93_descriptor *descs, unsigned int count,
+			  unsigned int *available);
 int eip93_put_descriptor(struct eip93_device *eip93, struct eip93_descriptor *desc);
--- a/drivers/crypto/inside-secure/eip93/eip93-hash.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-hash.c
@@ -41,1 +41,1 @@
-				 rctx->data_used, DMA_TO_DEVICE);
+				 SHA256_BLOCK_SIZE, DMA_TO_DEVICE);
@@ -215,394 +215,514 @@
-	INIT_LIST_HEAD(&rctx->blocks);
