From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PonWrt Maintainers <ponwrt@example.invalid>
Subject: [PATCH] crypto: eip93: use aligned request-local SA records

Keep the transform SA record as an immutable key/algorithm template. Copy it
into aligned request context storage and apply request-specific direction,
AEAD copy flags, and AAD offset there. DMA-map the private record for each
request and release that mapping on synchronous failure or completion.

This avoids both shared-transform races and per-request heap allocation.

---
--- a/drivers/crypto/inside-secure/eip93/eip93-cipher.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-cipher.c
@@ -28,3 +28,9 @@ skcipher completion SA unmap
-	eip93_handle_result(eip93, rctx, req->iv);
-
-	skcipher_request_complete(req, err);
+	eip93_handle_result(eip93, rctx, req->iv);
+	if (rctx->sa_record_mapped) {
+		dma_unmap_single(eip93->dev, rctx->sa_record_base,
+				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
+		rctx->sa_record_mapped = false;
+		rctx->sa_record_base = 0;
+	}
+
+	skcipher_request_complete(req, err);
@@ -41,4 +47,2 @@ skcipher synchronous error return
-	if (err) {
-		skcipher_request_complete(req, err);
-		return err;
-	}
+	if (err)
+		return err;
@@ -75,3 +79,1 @@ skcipher cra exit
-	dma_unmap_single(ctx->eip93->dev, ctx->sa_record_base,
-			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	kfree(ctx->sa_record);
+	kfree(ctx->sa_record);
@@ -156,5 +158,14 @@ skcipher request SA map
-	ctx->sa_record_base = dma_map_single(ctx->eip93->dev, ctx->sa_record,
-					     sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, ctx->sa_record_base);
-	if (ret)
-		return ret;
+	memcpy(&rctx->sa_record, ctx->sa_record, sizeof(rctx->sa_record));
+	if (IS_DECRYPT(rctx->flags))
+		rctx->sa_record.sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
+	else
+		rctx->sa_record.sa_cmd0_word &= ~EIP93_SA_CMD_DIRECTION_IN;
+
+	rctx->sa_record_base = dma_map_single(ctx->eip93->dev, &rctx->sa_record,
+					     sizeof(rctx->sa_record), DMA_TO_DEVICE);
+	ret = dma_mapping_error(ctx->eip93->dev, rctx->sa_record_base);
+	if (ret) {
+		rctx->sa_record_base = 0;
+		return -ENOMEM;
+	}
+	rctx->sa_record_mapped = true;
@@ -169,4 +180,10 @@ skcipher sync SA cleanup
-	rctx->desc_flags = EIP93_DESC_SKCIPHER;
-	rctx->sa_record_base = ctx->sa_record_base;
-
-	return eip93_skcipher_send_req(async);
+	rctx->desc_flags = EIP93_DESC_SKCIPHER;
+
+	ret = eip93_skcipher_send_req(async);
+	if (ret != -EINPROGRESS) {
+		dma_unmap_single(ctx->eip93->dev, rctx->sa_record_base,
+				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
+		rctx->sa_record_mapped = false;
+		rctx->sa_record_base = 0;
+	}
+	return ret;
@@ -189,2 +206,1 @@ remove decrypt ctx
-	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
-	struct eip93_cipher_reqctx *rctx = skcipher_request_ctx(req);
+	struct eip93_cipher_reqctx *rctx = skcipher_request_ctx(req);
@@ -194,2 +210,0 @@ remove shared decrypt flag
-	ctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
-
--- a/drivers/crypto/inside-secure/eip93/eip93-aead.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-aead.c
@@ -38,3 +38,9 @@ AEAD completion SA unmap
-	eip93_handle_result(eip93, rctx, req->iv);
-
-	aead_request_complete(req, err);
+	eip93_handle_result(eip93, rctx, req->iv);
+	if (rctx->sa_record_mapped) {
+		dma_unmap_single(eip93->dev, rctx->sa_record_base,
+				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
+		rctx->sa_record_mapped = false;
+		rctx->sa_record_base = 0;
+	}
+
+	aead_request_complete(req, err);
@@ -50,4 +56,2 @@ AEAD synchronous error return
-	if (err) {
-		aead_request_complete(req, err);
-		return err;
-	}
+	if (err)
+		return err;
@@ -70,3 +74,2 @@ remove assoc init
-	ctx->type = tmpl->type;
-	ctx->set_assoc = true;
-
+	ctx->type = tmpl->type;
+
@@ -84,3 +87,1 @@ AEAD cra exit
-	dma_unmap_single(ctx->eip93->dev, ctx->sa_record_base,
-			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	kfree(ctx->sa_record);
+	kfree(ctx->sa_record);
@@ -155,3 +156,1 @@ remove assoc setkey
-	ctx->set_assoc = true;
-
-	return ret;
+	return ret;
@@ -174,12 +173,0 @@ remove shared assoc helper
-static void eip93_aead_setassoc(struct eip93_crypto_ctx *ctx,
-				struct aead_request *req)
-{
-	struct sa_record *sa_record = ctx->sa_record;
-
-	sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
-	sa_record->sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
-					      req->assoclen / sizeof(u32));
-
-	ctx->assoclen = req->assoclen;
-}
-
@@ -186,30 +173,57 @@ AEAD request local SA
-static int eip93_aead_crypt(struct aead_request *req)
-{
-	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
-	struct crypto_async_request *async = &req->base;
-	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
-	struct crypto_aead *aead = crypto_aead_reqtfm(req);
-	int ret;
-
-	ctx->sa_record_base = dma_map_single(ctx->eip93->dev, ctx->sa_record,
-					     sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, ctx->sa_record_base);
-	if (ret)
-		return ret;
-
-	rctx->textsize = req->cryptlen;
-	rctx->blksize = ctx->blksize;
-	rctx->assoclen = req->assoclen;
-	rctx->authsize = ctx->authsize;
-	rctx->sg_src = req->src;
-	rctx->sg_dst = req->dst;
-	rctx->ivsize = crypto_aead_ivsize(aead);
-	rctx->desc_flags = EIP93_DESC_AEAD;
-	rctx->sa_record_base = ctx->sa_record_base;
-
-	if (IS_DECRYPT(rctx->flags))
-		rctx->textsize -= rctx->authsize;
-
-	return eip93_aead_send_req(async);
-}
-
+static int eip93_aead_crypt(struct aead_request *req)
+{
+	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
+	struct crypto_async_request *async = &req->base;
+	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
+	struct crypto_aead *aead = crypto_aead_reqtfm(req);
+	int ret;
+
+	if (IS_DECRYPT(rctx->flags) && req->cryptlen < ctx->authsize)
+		return -EINVAL;
+
+	memcpy(&rctx->sa_record, ctx->sa_record, sizeof(rctx->sa_record));
+	if (IS_DECRYPT(rctx->flags)) {
+		rctx->sa_record.sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
+		rctx->sa_record.sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD |
+						   EIP93_SA_CMD_COPY_DIGEST);
+	} else {
+		rctx->sa_record.sa_cmd0_word &= ~EIP93_SA_CMD_DIRECTION_IN;
+		rctx->sa_record.sa_cmd1_word |= EIP93_SA_CMD_COPY_PAD |
+						 EIP93_SA_CMD_COPY_DIGEST;
+	}
+
+	rctx->sa_record.sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+	rctx->sa_record.sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+						    req->assoclen / sizeof(u32));
+
+	rctx->sa_record_base = dma_map_single(ctx->eip93->dev, &rctx->sa_record,
+					     sizeof(rctx->sa_record), DMA_TO_DEVICE);
+	ret = dma_mapping_error(ctx->eip93->dev, rctx->sa_record_base);
+	if (ret) {
+		rctx->sa_record_base = 0;
+		return -ENOMEM;
+	}
+	rctx->sa_record_mapped = true;
+
+	rctx->textsize = req->cryptlen;
+	rctx->blksize = ctx->blksize;
+	rctx->assoclen = req->assoclen;
+	rctx->authsize = ctx->authsize;
+	rctx->sg_src = req->src;
+	rctx->sg_dst = req->dst;
+	rctx->ivsize = crypto_aead_ivsize(aead);
+	rctx->desc_flags = EIP93_DESC_AEAD;
+
+	if (IS_DECRYPT(rctx->flags))
+		rctx->textsize -= rctx->authsize;
+
+	ret = eip93_aead_send_req(async);
+	if (ret != -EINPROGRESS) {
+		dma_unmap_single(ctx->eip93->dev, rctx->sa_record_base,
+				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
+		rctx->sa_record_mapped = false;
+		rctx->sa_record_base = 0;
+	}
+	return ret;
+}
+
@@ -216,20 +230,11 @@ AEAD encrypt
-static int eip93_aead_encrypt(struct aead_request *req)
-{
-	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
-	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
-
-	rctx->flags = ctx->flags;
-	rctx->flags |= EIP93_ENCRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
-
-	return eip93_aead_crypt(req);
-}
-
+static int eip93_aead_encrypt(struct aead_request *req)
+{
+	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
+	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
+
+	rctx->flags = ctx->flags;
+	rctx->flags |= EIP93_ENCRYPT;
+
+	return eip93_aead_crypt(req);
+}
+
@@ -236,24 +241,11 @@ AEAD decrypt
-static int eip93_aead_decrypt(struct aead_request *req)
-{
-	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
-	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
-
-	ctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
-	ctx->sa_record->sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD |
-					  EIP93_SA_CMD_COPY_DIGEST);
-
-	rctx->flags = ctx->flags;
-	rctx->flags |= EIP93_DECRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
-
-	return eip93_aead_crypt(req);
-}
-
+static int eip93_aead_decrypt(struct aead_request *req)
+{
+	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
+	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
+
+	rctx->flags = ctx->flags;
+	rctx->flags |= EIP93_DECRYPT;
+
+	return eip93_aead_crypt(req);
+}
+
--- a/drivers/crypto/inside-secure/eip93/eip93-cipher.h
+++ b/drivers/crypto/inside-secure/eip93/eip93-cipher.h
@@ -11,1 +11,2 @@ regs include
-#include "eip93-main.h"
+#include "eip93-main.h"
+#include "eip93-regs.h"
@@ -18,3 +19,2 @@ remove transform dma base
-	int				blksize;
-	dma_addr_t			sa_record_base;
-	/* AEAD specific */
+	int				blksize;
+	/* AEAD specific */
@@ -22,2 +22,0 @@ remove shared AAD state
-	unsigned int			assoclen;
-	bool				set_assoc;
@@ -34,3 +32,5 @@ embedded request SA
-	unsigned int			authsize;
-	dma_addr_t			sa_record_base;
-	struct sa_state			*sa_state;
+	unsigned int			authsize;
+	struct sa_record		sa_record __aligned(CRYPTO_DMA_ALIGN);
+	dma_addr_t			sa_record_base;
+	bool				sa_record_mapped;
+	struct sa_state			*sa_state;
